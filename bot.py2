import os
import time
import hmac
import hashlib
import requests
from threading import Thread
from flask import Flask

# ----------------- 1. RENDER KEEP-ALIVE WEB SERVER -----------------
app = Flask(__name__)

@app.route('/')
def home():
    return "MEXC Futures Automated Trading Bot is Running 24/7!"

def run_web_server():
    while True:
        try:
            port = int(os.environ.get("PORT", 10000))
            app.run(host='0.0.0.0', port=port, use_reloader=False)
        except Exception as e:
            print(f"Web Server Restarting due to error: {e}", flush=True)
            time.sleep(5)

# Start web server in a resilient background thread
Thread(target=run_web_server, daemon=True).start()

# ----------------- 2. CONFIGURATION & CREDENTIALS -----------------
API_KEY = "mx0vglCptKlUtmb07M"
SECRET_KEY = "c19530d6d7404a509bdff4975bef5538" 

SYMBOL = "BTC_USDT"
POLL_INTERVAL_SEC = 15
BASE_URL = "https://contract.mexc.com"

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    "Accept": "application/json, text/plain, */*"
}

# ----------------- 3. MEXC API ORDER PLACEMENT -----------------
def place_mexc_order(side, price, size=0.01):
    """
    side: 1 for Long (Buy), 3 for Short (Sell)
    """
    if API_KEY == "your_mexc_api_key_here":
        print("[SIMULATION MODE] API Keys not set. Trade signal detected but order skipped.", flush=True)
        return False
        
    try:
        endpoint = "/api/v1/private/order/submit"
        timestamp = str(int(time.time() * 1000))
        
        params = {
            "symbol": SYMBOL,
            "side": side,          # 1: Open Long, 3: Open Short
            "openType": 1,         # 1: Isolated
            "type": 5,             # Market Order
            "vol": size,
            "leverage": 10
        }
        
        query_string = f"symbol={SYMBOL}&side={side}&openType=1&type=5&vol={size}&leverage=10&timestamp={timestamp}"
        signature = hmac.new(SECRET_KEY.encode('utf-8'), query_string.encode('utf-8'), hashlib.sha256).hexdigest()
        
        auth_headers = HEADERS.copy()
        auth_headers.update({
            "ApiKey": API_KEY,
            "Request-Time": timestamp,
            "Sign": signature,
            "Content-Type": "application/json"
        })
        
        response = requests.post(BASE_URL + endpoint, json=params, headers=auth_headers, timeout=10)
        res_data = response.json()
        
        if res_data.get("success"):
            print(f">>> LIVE TRADE EXECUTED SUCCESSFULLY! Side: {side} | Price: ${price}", flush=True)
            return True
        else:
            print(f"Trade Failed: {res_data.get('message')}", flush=True)
            
    except Exception as e:
        print(f"Order Placement Exception: {e}", flush=True)
    return False

# ----------------- 4. MARKET DATA & STRATEGY LOGIC -----------------
def get_market_data():
    try:
        url = f"{BASE_URL}/api/v1/contract/kline/{SYMBOL}?interval=Min15&limit=50"
        response = requests.get(url, headers=HEADERS, timeout=10)
        res_json = response.json()
        
        data = res_json.get("data")
        if res_json.get("success") and data:
            closes, highs, lows, volumes = [], [], [], []
            
            if isinstance(data, dict):
                closes = data.get("close", [])
                highs = data.get("high", [])
                lows = data.get("low", [])
                volumes = data.get("volume", [])
            elif isinstance(data, list):
                for item in data:
                    if isinstance(item, dict):
                        closes.append(item.get("close", 0))
                        highs.append(item.get("high", 0))
                        lows.append(item.get("low", 0))
                        volumes.append(item.get("vol", 0))
                    elif isinstance(item, list) and len(item) > 5:
                        closes.append(item[4])
                        highs.append(item[2])
                        lows.append(item[3])
                        volumes.append(item[5])
            
            if closes and len(closes) >= 15:
                float_closes = [float(c) for c in closes if c is not None]
                float_highs = [float(h) for h in highs if h is not None]
                float_lows = [float(l) for l in lows if l is not None]
                float_vols = [float(v) for v in volumes if v is not None]
                
                if len(float_closes) >= 15:
                    current_price = float_closes[-1]
                    current_volume = float_vols[-1] if float_vols else 0
                    avg_volume = sum(float_vols[-15:]) / 15 if len(float_vols) >= 15 else current_volume
                    
                    # RSI Calculation (14 periods)
                    gains, losses = 0, 0
                    for i in range(-14, 0):
                        change = float_closes[i] - float_closes[i-1]
                        if change > 0:
                            gains += change
                        else:
                            losses -= change
                    rs = (gains / 14) / (losses / 14) if losses > 0 else 100
                    rsi = 100 - (100 / (1 + rs))
                    
                    recent_high = max(float_highs[-10:-1]) if len(float_highs) >= 10 else float_highs[-1]
                    recent_low = min(float_lows[-10:-1]) if len(float_lows) >= 10 else float_lows[-1]
                    
                    sweep_high = float_highs[-1] > recent_high and current_price < recent_high
                    sweep_low = float_lows[-1] < recent_low and current_price > recent_low
                    
                    return {
                        "price": current_price,
                        "rsi": rsi,
                        "volume": current_volume,
                        "avg_volume": avg_volume,
                        "sweep_high": sweep_high,
                        "sweep_low": sweep_low
                    }
    except Exception as e:
        print(f"Market Data Error: {e}", flush=True)
    return None

# ----------------- 5. BULLETPROOF TRADING LOOP -----------------
def trading_bot_loop():
    print("ICT 24/7 Automated Trading Bot Initialized & Running...", flush=True)
    while True:
        try:
            market = get_market_data()
            if market:
                price = market["price"]
                rsi = market["rsi"]
                vol = market["volume"]
                avg_vol = market["avg_volume"]
                sweep_high = market["sweep_high"]
                sweep_low = market["sweep_low"]
                
                print(f"[Price: ${price:.2f} | RSI: {rsi:.1f} | Vol: {vol:.0f}] Scanning Market...", flush=True)
                
                is_good_volume = vol > (avg_vol * 1.1)
                
                if is_good_volume and sweep_low and (32 <= rsi <= 60):
                    print(f"EARLY REVERSAL LONG SIGNAL at ${price:.2f}", flush=True)
                    place_mexc_order(side=1, price=price) # Long
                
                elif is_good_volume and sweep_high and (40 <= rsi <= 68):
                    print(f"EARLY REVERSAL SHORT SIGNAL at ${price:.2f}", flush=True)
                    place_mexc_order(side=3, price=price) # Short
            else:
                print("Retrying market data fetch...", flush=True)
                    
        except Exception as e:
            print(f"Trading Loop Recovered from Error: {e}", flush=True)
            
        time.sleep(POLL_INTERVAL_SEC)

# Start trading bot in a safe background thread
Thread(target=trading_bot_loop, daemon=True).start()

if __name__ == "__main__":
    port = int(os.environ.get("PORT", 10000))
    app.run(host='0.0.0.0', port=port, use_reloader=False)
