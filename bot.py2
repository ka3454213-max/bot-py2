}

# ----------------- 3. MARKET DATA LOGIC -----------------
def get_market_data():
    try:
        url = f"https://contract.mexc.com/api/v1/contract/kline/{SYMBOL}?interval=Min15&limit=60"
        response = requests.get(url, headers=HEADERS, timeout=10)
        res_json = response.json()
        
        # Safe extraction for MEXC API response format
        data = res_json.get("data")
        if res_json.get("success") and isinstance(data, dict):
            closes = data.get("close", [])
            highs = data.get("high", [])
            lows = data.get("low", [])
            volumes = data.get("volume", [])
            
            if closes and len(closes) > 15:
                current_price = float(closes[-1])
                current_volume = float(volumes[-1])
                avg_volume = sum([float(v) for v in volumes[-15:]]) / 15
                
                # RSI Calculation (14 periods)
                gains, losses = 0, 0
                float_closes = [float(c) for c in closes]
                for i in range(-14, 0):
                    change = float_closes[i] - float_closes[i-1]
                    if change > 0:
                        gains += change
                    else:
                        losses -= change
                rs = (gains / 14) / (losses / 14) if losses > 0 else 100
                rsi = 100 - (100 / (1 + rs))
                
                float_highs = [float(h) for h in highs]
                float_lows = [float(l) for l in lows]
                recent_high = max(float_highs[-10:-1])
                recent_low = min(float_lows[-10:-1])
                
                sweep_high = float_highs[-1] > recent_high and current_price < recent_high
                sweep_low = float_lows[-1] < recent_low and current_price > recent_low
                
                return {
                    "price": current_price,
                    "rsi": rsi,
                    "volume": current_volume,
                    "avg_volume": avg_volume,
                    "sweep_high": sweep_high,
                    "sweep_low": sweep_low
                }
    except Exception as e:
        print(f"Market Data Error: {e}", flush=True)
    return None

# ----------------- 4. TRADING BOT LOOP -----------------
def trading_bot():
    print("ICT Early Reversal Bot Initialized & Scanning...", flush=True)
    
    while True:
        try:
            market = get_market_data()
            if market:
                price = market["price"]
                rsi = market["rsi"]
                vol = market["volume"]
                avg_vol = market["avg_volume"]
                sweep_high = market["sweep_high"]
                sweep_low = market["sweep_low"]
                
                print(f"[Price: ${price:.2f} | RSI: {rsi:.1f} | Vol: {vol:.0f}] Scanning Market Structure...", flush=True)
                
                is_good_volume = vol > (avg_vol * 1.1)
                
                if is_good_volume and sweep_low and (32 <= rsi <= 60):
                    print(f"EARLY REVERSAL LONG SIGNAL DETECTED at ${price:.2f} (Sweep Low + RSI Confirmed)", flush=True)
                
                elif is_good_volume and sweep_high and (40 <= rsi <= 68):
                    print(f"EARLY REVERSAL SHORT SIGNAL DETECTED at ${price:.2f} (Sweep High + RSI Confirmed)", flush=True)
                    
        except Exception as e:
            print(f"Loop Error: {e}", flush=True)
            
        time.sleep(POLL_INTERVAL_SEC)

# Run trading bot loop in a background thread
Thread(target=trading_bot, daemon=True).start()

# Keep main thread alive for Render web service
if __name__ == "__main__":
    port = int(os.environ.get("PORT", 8080))
    app.run(host='0.0.0.0', port=port, use_reloader=False)
